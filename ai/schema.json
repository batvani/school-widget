{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batvani.github.io/school-widget/ai/schema.json",
  "title": "School Widget timetable, schema 1",
  "$comment": "important (a red class) is the person's own reminder: the AI asks about it; a timetable shared with the class leaves it out.",
  "description": "What School Widget imports (ai/INSTRUCTIONS.md). The script's own checks (validateData) are the final word: they also check that bells don't overlap and that a day has no more periods than bells.",
  "type": "object",
  "required": ["meta", "bells", "week"],
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "names": { "type": "object", "additionalProperties": { "type": "string" } },
    "group": {
      "type": "object", "required": ["label", "name"], "additionalProperties": false,
      "properties": { "label": { "type": "string", "minLength": 1 }, "name": { "type": "string" }, "room": { "type": "string" }, "important": { "type": "boolean" } }
    },
    "cell": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "description": "A period. A free period is { \"name\": \"\" }.",
      "properties": {
        "name": { "type": "string" }, "room": { "type": "string" }, "important": { "type": "boolean" },
        "groups": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/group" } }
      }
    },
    "dayOff": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "type": "array", "prefixItems": [{ "$ref": "#/$defs/date" }, { "type": "string" }], "minItems": 2, "maxItems": 2 },
        { "type": "array", "prefixItems": [{ "$ref": "#/$defs/date" }, { "$ref": "#/$defs/date" }, { "type": "string" }], "minItems": 3, "maxItems": 3 }
      ]
    }
  },
  "properties": {
    "meta": {
      "type": "object", "required": ["schema"],
      "properties": {
        "schema": { "const": 1 },
        "class": { "type": "string" }, "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
        "schoolYear": { "type": "string" }, "semester": { "type": "integer" },
        "photo": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "groups": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "noRoom": { "type": "array", "items": { "type": "string" } },
        "created": { "type": "string" }, "source": { "type": "string" }, "instructions": { "type": "string" }
      }
    },
    "lastDay": { "$ref": "#/$defs/date" },
    "bells": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/time" }, { "$ref": "#/$defs/time" }], "minItems": 2, "maxItems": 2 } },
    "week": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": { "^[1-6]$": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/cell" } } }
    },
    "short": { "$ref": "#/$defs/names" }, "tiny": { "$ref": "#/$defs/names" },
    "icons": { "$ref": "#/$defs/names" }, "holidayIcons": { "$ref": "#/$defs/names" },
    "daysOff": { "type": "array", "items": { "$ref": "#/$defs/dayOff" } },
    "notOff": { "type": "array", "items": { "$ref": "#/$defs/date" } }
  }
}
